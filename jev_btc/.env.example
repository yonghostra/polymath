# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is git-ignored. Never commit your real key.

# ---- Jev (TypeSafe AI) ----
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SEC=3
JEV_MAX_RETRIES=1
JEV_MAX_CALLS_PER_SEC=5
JEV_MAX_INFLIGHT=4
# USD per 1M tokens - check the official pricing page
JEV_COST_PER_M_INPUT=0.042
JEV_COST_PER_M_OUTPUT=0
# 1 = fake random predictions (no key, no cost) to test the pipeline
JEV_MOCK=0

# ---- Experiment ----
SYMBOL=BTCUSDT
REF_SYMBOL=ETHUSDT
HORIZON_SEC=10
# 1, 2, 5 ... seconds between Jev predictions (snapshots are always every second)
PREDICT_EVERY_SEC=1
# 0.0002 = 0.02%. |10s return| below this counts as FLAT
FLAT_THRESHOLD=0.0002
# mid = (bid+ask)/2 (recommended) or last = last trade price
PRICE_SOURCE=mid
HIGH_CONF_PROB=0.80
WARMUP_SEC=30

# ---- Binance (public data, no key needed) ----
BINANCE_WS_URL=wss://fstream.binance.com/stream
BINANCE_REST_URL=https://fapi.binance.com
OPEN_INTEREST_POLL_SEC=10
WS_STALE_TIMEOUT_SEC=10
MAX_DATA_AGE_SEC=5

# ---- Storage ----
# DB_PATH=data/jev_btc.db
